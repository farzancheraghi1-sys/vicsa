rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function counterPath() {
      return /databases/$(database)/documents/counters/users;
    }

    match /users/{uid} {
      allow read: if signedIn();

      // Sign-up: the new user gets the next numeric User ID, issued in the
      // same transaction that bumps counters/users by exactly 1.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             "nick", "userId", "verified", "hasPhoto", "albumsCount", "gender",
             "avatar", "nickColor", "city", "country", "recordType",
             "friendsCount", "familyStatus", "siblings", "createdAt"
           ])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() > 0
        && request.resource.data.nick.size() <= 30
        && request.resource.data.verified == false
        && request.resource.data.recordType == "Unconfirmed"
        && request.resource.data.userId == getAfter(counterPath()).data.next
        && getAfter(counterPath()).data.next == get(counterPath()).data.next + 1;

      // Owner edits own profile, but never userId / verified / recordType.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             "nick", "hasPhoto", "albumsCount", "gender", "avatar", "nickColor",
             "city", "country", "familyStatus", "siblings", "friendsCount"
           ]);

      // Admins (documents in /admins) may set the verified badge and record type.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             "verified", "recordType"
           ]);

      allow delete: if false;
    }

    match /counters/users {
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(["next"])
        && request.resource.data.next == resource.data.next + 1;
      allow create, delete: if false;
    }

    match /admins/{adminUid} {
      allow read, write: if false;
    }
  }
}
